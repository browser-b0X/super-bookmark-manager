{
  "manifest_version": 3,
  "name": "SuperBookmarks",
  "version": "0.4.0",
  "description": "Save pages, links and posts (X, Instagram, TikTok) to SuperBookmarks on this computer. Talks only to the app on 127.0.0.1.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Save to SuperBookmarks",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "permissions": ["activeTab", "contextMenus", "scripting", "storage"],
  "optional_permissions": ["tabs"],
  "host_permissions": ["http://127.0.0.1/*"],
  "optional_host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://www.instagram.com/*", "https://www.tiktok.com/*"]
}
