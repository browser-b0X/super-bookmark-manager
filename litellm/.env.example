# Copy to .env and fill in your keys. start_proxy.sh sources this file.
#
#   Groq:     https://console.groq.com/keys           (free tier)
#   Gemini:   https://aistudio.google.com/apikey      (free tier)
#   Mistral:  https://console.mistral.ai/api-keys     (free tier)
#
# The local llama-server tier needs no cloud key — LLM_BASE_URL/LLM_API_KEY
# default to the dashboard's own values in config.py.

GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=not-needed
